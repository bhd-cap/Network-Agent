# Copy to .env and adjust. Every setting is optional.

# --- Console / API ---------------------------------------------------------
# Admin token used to sign in to the web console and as the master API token.
# If unset, one is generated on first start and stored in the data directory
# (print it with:  python -m netagent token).
#NETAGENT_ADMIN_TOKEN=change-me
#NETAGENT_HOST=0.0.0.0
#NETAGENT_PORT=8080
# Public base URL of the console; used in Teams/email links and webhook URLs.
#NETAGENT_PUBLIC_URL=https://netagent.example.com
#NETAGENT_DATA_DIR=./data
#NETAGENT_LOG_LEVEL=INFO

# Key that encrypts stored credentials (device passwords, API keys, channel
# secrets). If unset, one is generated into the data directory. Back it up.
#NETAGENT_SECRET_KEY=

# Explore with offline mock models and simulated devices (no keys needed).
#NETAGENT_DEMO=1

# --- Models ----------------------------------------------------------------
# Cloud tiers (Claude). Leave unset to run local-only.
#ANTHROPIC_API_KEY=
# Local tiers (Ollama). Leave as-is if Ollama runs on this machine.
#OLLAMA_BASE_URL=http://localhost:11434
